    "import pandas as pd\n",
    "\n",
    "df_greek = pd.read_csv('Greek.csv',sep='\\t')\n",
    "df_greek\n",
    "df_greek.filter(regex='hathi')\n",
    "mask = df_greek.apply(lambda row: row.astype(str).str.contains('hathi', case=False)).any(axis=1)\n",
    "filtered_df = df_greek[mask]\n",
    "\n",
    "print(filtered_df)"
